<section class="page-width section"><h1 class="heading heading-lg">{{ 'general.search' | t }}</h1><form action="{{ routes.search_url }}" method="get"><input type="hidden" name="type" value="product"><input type="search" name="q" value="{{ search.terms | escape }}" aria-label="{{ 'general.search' | t }}" style="padding:14px;border:1px solid var(--line);width:min(600px,100%)"><button class="button">{{ 'general.search' | t }}</button></form>{% if search.performed %}{% paginate search.results by 24 %}<div class="collection-grid" style="margin-top:30px">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<p>{{ 'search.no_results' | t }}</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>{% schema %}{"name":"Main search","settings":[]}{% endschema %}
