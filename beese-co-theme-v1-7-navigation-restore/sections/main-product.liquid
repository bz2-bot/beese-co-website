<section class="page-width product-page product-master" data-product-root>
  <div class="product-gallery product-master__gallery" data-product-gallery>
    <div class="product-gallery__main">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', data-main-image: '', alt: product.featured_image.alt | default: product.title }}
      {% else %}
        <img src="{{ 'placeholder-product.svg' | asset_url }}" class="theme-placeholder-image" alt="Product image placeholder" loading="eager">
      {% endif %}
    </div>

    {% if product.images.size > 1 %}
      <div class="product-thumbs" aria-label="Product images">
        {% for image in product.images %}
          <button class="product-thumb" type="button" data-thumb data-src="{{ image | image_url: width: 1800 }}" data-alt="{{ image.alt | default: product.title | escape }}" data-tags="{{ image.alt | escape }}" {% if forloop.first %}aria-current="true"{% endif %}>
            {{ image | image_url: width: 260 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="product-form-wrap">
    <div class="product-master__intro">
      <div class="product-master__badge">Custom made for you</div>
      <h1 class="heading heading-md">{{ product.title }}</h1>
      <div class="product-master__price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</div>
      <div class="product-master__note">Digital proof included before production begins.</div>
      {% if product.description != blank %}
        <div class="product-master__summary">{{ product.description }}</div>
      {% endif %}
    </div>

    {% form 'product', product, enctype: 'multipart/form-data', data-product-form: '' %}
      {% unless product.has_only_default_variant %}
        <div class="product-master__step">
          <div class="product-master__step-head">
            <span class="product-master__step-number">1</span>
            <div>
              <h2 class="product-master__step-title">Choose your tumbler</h2>
              <p class="product-master__step-help">Select the available color and finish options below.</p>
            </div>
          </div>

          {% for option in product.options_with_values %}
            <fieldset class="field" data-option-position="{{ option.position }}">
              <legend>{{ option.name }} <span class="required-mark" aria-hidden="true">*</span></legend>
              <div class="choice-row">
                {% for value in option.values %}
                  <div class="choice">
                    <input type="radio" id="opt-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                    <label for="opt-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value }}</label>
                  </div>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>
      {% endunless %}

      {% if section.settings.show_decoration %}
        <div class="product-master__step">
          <div class="product-master__step-head">
            <span class="product-master__step-number">2</span>
            <div>
              <h2 class="product-master__step-title">Choose your design method</h2>
              <p class="product-master__step-help">We will confirm placement and details in your proof.</p>
            </div>
          </div>

          <fieldset class="field" data-decoration-choice>
            <legend class="visually-hidden">Decoration method</legend>
            <div class="product-master__method-grid">
              <div class="product-master__method">
                <input type="radio" id="dec-laser-{{ section.id }}" name="properties[Decoration Method]" value="Laser Engraved Full Wrap" required checked>
                <label for="dec-laser-{{ section.id }}">
                  <strong>Laser Engraved</strong>
                  <span>Permanent, premium engraving. Offered as a full-wrap design on this tumbler.</span>
                </label>
              </div>
              {% unless section.settings.laser_only %}
                <div class="product-master__method">
                  <input type="radio" id="dec-full-{{ section.id }}" name="properties[Decoration Method]" value="Full Color UV Print">
                  <label for="dec-full-{{ section.id }}">
                    <strong>Full Color UV</strong>
                    <span>Bright, detailed printing for logos, photos, and multicolor artwork.</span>
                  </label>
                </div>
              {% endunless %}
            </div>
          </fieldset>
        </div>
      {% endif %}

      <div class="product-master__step">
        <div class="product-master__step-head">
          <span class="product-master__step-number">3</span>
          <div>
            <h2 class="product-master__step-title">Tell us what to create</h2>
            <p class="product-master__step-help">Give us everything needed to prepare an accurate proof without extra back-and-forth.</p>
          </div>
        </div>

        <div class="field">
          <label for="Personalization-{{ section.id }}">Personalization</label>
          <input id="Personalization-{{ section.id }}" type="text" name="properties[Personalization]" placeholder="Name, monogram, wording, date, or other text">
          <span class="field-help">Enter spelling and capitalization exactly as you want it shown.</span>
        </div>

        <div class="field">
          <label for="Artwork-{{ section.id }}">Upload artwork or inspiration</label>
          <div class="product-master__upload">
            <input id="Artwork-{{ section.id }}" type="file" name="properties[Artwork Upload]" accept=".png,.jpg,.jpeg,.pdf,.svg">
          </div>
          <span class="field-help">Upload a logo, photo, sketch, screenshot, or inspiration image. PNG, JPG, PDF, and SVG accepted.</span>
        </div>

        <div class="field">
          <label for="Instructions-{{ section.id }}">Special instructions</label>
          <textarea id="Instructions-{{ section.id }}" name="properties[Special Instructions]" placeholder="Describe placement, colors, style, wording, or anything else we should know."></textarea>
        </div>
      </div>

      <div class="product-master__step">
        <div class="product-master__step-head">
          <span class="product-master__step-number">4</span>
          <div>
            <h2 class="product-master__step-title">Proof contact</h2>
            <p class="product-master__step-help">Production starts only after you approve the digital proof.</p>
          </div>
        </div>

        <div class="field">
          <label for="Phone-{{ section.id }}">Mobile phone number <span class="required-mark" aria-hidden="true">*</span></label>
          <input id="Phone-{{ section.id }}" type="tel" name="properties[Phone Number for Proof]" autocomplete="tel" inputmode="tel" required placeholder="(555) 555-5555">
          <span class="field-help">We use this number only for your order proof and order questions.</span>
        </div>

        <div class="field proof-check product-master__agreement">
          <input id="Proof-{{ section.id }}" type="checkbox" name="properties[Digital Proof Agreement]" value="Agreed" required>
          <label for="Proof-{{ section.id }}">I understand I will receive a digital proof by text before production. I have checked that my phone number is correct, and production will not begin until I approve the proof.</label>
        </div>
      </div>

      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

      <div class="qty-row product-master__submit">
        <input type="number" name="quantity" min="1" value="1" inputmode="numeric" aria-label="Quantity">
        <button class="button" type="submit" data-add-button {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          <span data-add-label>{% if product.selected_or_first_available_variant.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
        </button>
      </div>
      <div class="product-master__secure">Your customization details are saved with your order.</div>
    {% endform %}

    <div class="product-master__trust" aria-label="Order benefits">
      <div class="product-master__trust-item"><strong>Proof included</strong><span>Approve before we make it</span></div>
      <div class="product-master__trust-item"><strong>Made to order</strong><span>Crafted for your request</span></div>
      <div class="product-master__trust-item"><strong>Pickup or shipping</strong><span>Choose at checkout</span></div>
    </div>

    <div class="product-master__details">
      <details>
        <summary>How the proof process works</summary>
        <div class="product-master__details-content"><p>After checkout, Beese & Co. prepares a digital proof using the information and artwork submitted with your order. The proof is sent by text. Production begins only after approval.</p></div>
      </details>
      <details>
        <summary>Artwork guidance</summary>
        <div class="product-master__details-content"><p>Send the best file available. Clear, high-resolution artwork produces the strongest result. We will contact you if the submitted art needs adjustment before proofing.</p></div>
      </details>
      <details>
        <summary>Turnaround</summary>
        <div class="product-master__details-content"><p>Most custom orders are completed within 1–2 weeks after proof approval. Larger or highly detailed orders may require additional time.</p></div>
      </details>
    </div>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {"type":"checkbox","id":"show_decoration","label":"Show decoration method","default":true},
    {"type":"checkbox","id":"laser_only","label":"Laser only","default":false}
  ]
}
{% endschema %}
