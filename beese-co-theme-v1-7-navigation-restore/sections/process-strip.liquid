<section class="section"><div class="page-width"><div class="section-title"><h2 class="heading heading-md">{{ section.settings.heading }}</h2></div><div class="process">{% for block in section.blocks %}<div class="process__item"><div class="process__num">{{ forloop.index }}</div><strong>{{ block.settings.heading }}</strong><p>{{ block.settings.text }}</p></div>{% else %}{% for step in (1..4) %}{% assign heading_key = 'process.step_' | append: step | append: '_heading' %}{% assign body_key = 'process.step_' | append: step | append: '_body' %}<div class="process__item"><div class="process__num">{{ step }}</div><strong>{{ heading_key | t }}</strong><p>{{ body_key | t }}</p></div>{% endfor %}{% endfor %}</div></div></section>{% schema %}{"name":"Process strip","settings":[{"type":"text","id":"heading","label":"Heading","default":"How It Works"}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"heading","label":"Heading","default":"Choose"},{"type":"text","id":"text","label":"Text","default":"Select your product."}]}],"max_blocks":5,"presets":[{"name":"Process strip"}]}{% endschema %}
