{% if section.settings.products != blank %}
  <section class="home-products" aria-labelledby="HomeProducts-{{ section.id }}">
    <div class="page-width collection-products">
      <div class="section-title"><h2 class="heading heading-md" id="HomeProducts-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
      <div class="collection-grid">
        {% for product in section.settings.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name": "Homepage products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop products" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 }
  ],
  "presets": [{ "name": "Homepage products" }]
}
{% endschema %}
