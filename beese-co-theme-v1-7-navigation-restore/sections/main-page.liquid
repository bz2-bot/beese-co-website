{% if page.handle == 'contact' %}
  {% render 'contact-landing-static' %}
{% else %}
<section class="page-width section">
  <h1 class="heading heading-lg">{{ page.title }}</h1>
  <div>{% if page.handle == 'about-us' %}
    <p>{{ 'pages.about.intro' | t }}</p><p>{{ 'pages.about.process' | t }}</p><a class="button" href="{{ routes.root_url }}pages/contact">{{ 'pages.about.button' | t }}</a>
  {% elsif page.handle == 'faq' %}
    <h2>{{ 'pages.faq.payment_heading' | t }}</h2><p>{{ 'pages.faq.payment' | t }}</p>
    <h2>{{ 'pages.faq.proof_heading' | t }}</h2><p>{{ 'pages.faq.proof' | t }}</p>
    <h2>{{ 'pages.faq.shipping_heading' | t }}</h2><p>{{ 'pages.faq.shipping' | t }}</p>
    <a href="{{ routes.root_url }}pages/contact">{{ 'pages.about.button' | t }}</a>
  {% elsif page.handle == 'uv-printed-tumblers' %}
    <a class="button" href="{{ routes.root_url }}collections/uv-printed-tumblers">{{ 'pages.uv.button' | t }}</a>
  {% else %}{{ page.content }}{% endif %}</div>
</section>
{% endif %}
{% schema %}{"name":"Main page","settings":[]}{% endschema %}
