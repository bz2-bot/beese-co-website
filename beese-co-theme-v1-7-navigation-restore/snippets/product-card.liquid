{% doc %}
Renders a product with its image and pricing.
@param {product} product - Product to display.
{% enddoc %}
<a class="product-card" href="{{ product.url }}"><div class="product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}<img src="{{ 'placeholder-product.svg' | asset_url }}" class="theme-placeholder-image" alt="Product image placeholder" width="900" height="900" loading="lazy">{% endif %}</div><div class="product-card__info"><div class="product-card__title">{{ product.title }}</div><div class="product-card__price">{% if product.price_min == 0 or product.handle == 'custom-golf-ball' or product.handle == 'custom-engraving' or product.handle == 'custom-printing' %}{{ 'products.quote.card' | t }}{% elsif product.price_varies %}{% assign formatted_price = product.price | money %}{{ 'products.price.from' | t: price: formatted_price }}{% else %}{{ product.price | money }}{% endif %}</div></div></a>
